{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "devCommand": "node server.js",
  "env": {
    "PORT": "3000"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
